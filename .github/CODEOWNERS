# Separation of duties, enforced by branch protection ("Require review from Code Owners").
# Replace the team handles with your own GitHub teams or usernames.

*                                        @your-github-org/platform-team

# Product publication and consumer approval: the producing domain decides.
/config/products/claims.yaml             @your-github-org/claims-data-team
/config/products/policy_financial.yaml   @your-github-org/policy-financial-team
/config/products/profitability.yaml      @your-github-org/profitability-team

# Consumer domains: their lead owns the definition.
/config/consumers/exec_reporting.yaml    @your-github-org/exec-reporting-leads

# Governance: tag taxonomy, masks, sensitive access roles, ABAC policies.
/config/governed_tags.yaml               @your-github-org/governance-team
/config/sars.yaml                        @your-github-org/governance-team
/sql/governance/                         @your-github-org/governance-team
/stacks/60-governance/                   @your-github-org/governance-team

# Access model and naming: platform and governance together.
/config/access_matrix.yaml               @your-github-org/platform-team @your-github-org/governance-team
/config/personas.yaml                    @your-github-org/platform-team @your-github-org/governance-team
/modules/naming/                         @your-github-org/platform-team @your-github-org/governance-team

# What a domain's roles may do (its schema access and persona access): platform and governance decide.
# The domain's own shape (extra schemas, roles, personas by name) is the domain team's call; add one line
# per domain, next to its products file above.
/config/domain_access/                   @your-github-org/platform-team @your-github-org/governance-team
/config/domain_shape/claims.yaml         @your-github-org/claims-data-team
/config/domain_shape/policy_financial.yaml @your-github-org/policy-financial-team
/config/domain_shape/profitability.yaml  @your-github-org/profitability-team

# Entitlements (who is in which group, which approvals are given). Stand-in for an IAM tool.
# Nonprod is platform's call; the prod environment needs platform AND governance.
/config/entitlements/                    @your-github-org/platform-team
/config/entitlements/prd/                @your-github-org/platform-team @your-github-org/governance-team
/config/entitlements/*/sars.yaml         @your-github-org/governance-team
/config/entitlements/*/product_access.yaml @your-github-org/platform-team

# Pipelines: who may change how things get deployed.
/.github/workflows/                      @your-github-org/platform-team @your-github-org/governance-team
/scripts/                                @your-github-org/platform-team
/util/                                   @your-github-org/platform-team

# Shared raw vault definition.
/config/domains.yaml                     @your-github-org/platform-team @your-github-org/vault-team

# Production experiments require explicit approval.
/config/entitlements/prd/experiments.yaml @your-github-org/platform-leads
